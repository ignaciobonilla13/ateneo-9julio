# MongoDB Atlas o un Mongo local. En producción es obligatorio.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/paglu

# Clave compartida del presentador y del editor. Cambiala.
PRESENTER_KEY=cambiala

# URL pública HTTPS con la que se arma el QR. Sin barra final.
PUBLIC_URL=https://tu-dominio.example

PORT=3001

# Solo desarrollo, si no tenés Mongo instalado. Nunca lo actives en producción.
# ALLOW_MEMORY_MONGO=1
